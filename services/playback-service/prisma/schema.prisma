generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WatchProgress {
  id             String   @id @default(uuid())
  userId         String
  titleId        String
  positionSeconds Int
  updatedAt      DateTime @updatedAt

  @@unique([userId, titleId])
}
