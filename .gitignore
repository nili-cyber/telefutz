# Terraform - state can contain secrets in plain text (DB passwords, etc.)
# and tfvars is where you put real Stripe/PayPal keys. Neither belongs in
# git, ever - not even in a private repo.
infra/aws/.terraform/
infra/aws/*.tfstate
infra/aws/*.tfstate.*
infra/aws/*.tfplan
infra/aws/terraform.tfvars
